<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MySqlPunk.Desktop.TableDataEditorWindow"
        Title="資料表內容"
        Width="1100"
        Height="720"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
    <Border Grid.Row="0" Background="#172033" Padding="16,12">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock x:Name="TitleText" Foreground="White" FontSize="18" FontWeight="SemiBold" />
          <TextBlock x:Name="SchemaText" Foreground="#B9C7E8" FontSize="12" />
        </StackPanel>
        <Button Grid.Column="1" x:Name="PreviousButton" Content="上一頁" Click="Previous_Click" Margin="8,0,0,0" Foreground="White" Background="#263451" />
        <TextBlock Grid.Column="2" x:Name="PageText" Text="第 1 頁" MinWidth="58" Margin="8,0,0,0" Foreground="White" VerticalAlignment="Center" TextAlignment="Center" />
        <Button Grid.Column="3" x:Name="NextButton" Content="下一頁" Click="Next_Click" Margin="8,0,0,0" Foreground="White" Background="#263451" />
        <Button Grid.Column="4" x:Name="AddButton" Content="新增列" Click="Add_Click" Margin="8,0,0,0" Foreground="White" Background="#263451" />
        <Button Grid.Column="5" x:Name="EditButton" Content="修改列" Click="Edit_Click" Margin="8,0,0,0" Foreground="White" Background="#263451" />
        <Button Grid.Column="6" x:Name="DeleteButton" Content="刪除列" Click="Delete_Click" Margin="8,0,0,0" Foreground="White" Background="#263451" />
        <Button Grid.Column="7" x:Name="RefreshButton" Content="重新整理" Click="Refresh_Click" Margin="8,0,0,0" Foreground="White" Background="#263451" />
        <Button Grid.Column="8" x:Name="CloseButton" Content="關閉" Click="Close_Click" Margin="8,0,0,0" Foreground="White" Background="#263451" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="#F8FAFD" BorderBrush="#CDD5E0" BorderThickness="0,0,0,1" Padding="12,8">
      <Grid ColumnDefinitions="Auto,260,Auto,150,*,Auto,82,Auto">
        <TextBlock Grid.Column="0" Text="排序欄位" Margin="0,0,8,0" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1"
                  x:Name="SortColumnCombo"
                  SelectionChanged="Sort_SelectionChanged" />
        <TextBlock Grid.Column="2" Text="方向" Margin="16,0,8,0" VerticalAlignment="Center" />
        <ComboBox Grid.Column="3"
                  x:Name="SortDirectionCombo"
                  SelectionChanged="Sort_SelectionChanged" />
        <TextBlock Grid.Column="4"
                   Text="相同值會再依 Primary Key 排序，跨頁不會因平手而漏列或重複。"
                   Margin="16,0,0,0"
                   Foreground="#5F6B7A"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap" />
        <TextBlock Grid.Column="5" Text="格式" Margin="12,0,7,0" VerticalAlignment="Center" />
        <ComboBox Grid.Column="6" x:Name="ExportFormatCombo" SelectedIndex="0">
          <ComboBoxItem Content="CSV" />
          <ComboBoxItem Content="TSV" />
          <ComboBoxItem Content="JSON" />
        </ComboBox>
        <Button Grid.Column="7"
                x:Name="ExportPageButton"
                Content="匯出本頁…"
                Click="ExportPage_Click"
                Margin="7,0,0,0" />
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="#F8FAFD" BorderBrush="#CDD5E0" BorderThickness="0,0,0,1" Padding="12,8">
      <Grid ColumnDefinitions="Auto,230,Auto,145,*,Auto,Auto">
        <TextBlock Grid.Column="0" Text="篩選欄位" Margin="0,0,8,0" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1"
                  x:Name="FilterColumnCombo"
                  SelectionChanged="FilterControl_Changed" />
        <TextBlock Grid.Column="2" Text="條件" Margin="16,0,8,0" VerticalAlignment="Center" />
        <ComboBox Grid.Column="3"
                  x:Name="FilterOperatorCombo"
                  SelectionChanged="FilterControl_Changed" />
        <TextBox Grid.Column="4"
                 x:Name="FilterValueBox"
                 PlaceholderText="依欄位型別輸入精確值"
                 Margin="12,0,0,0" />
        <Button Grid.Column="5"
                x:Name="ApplyFilterButton"
                Content="套用"
                Click="ApplyFilter_Click"
                Margin="8,0,0,0" />
        <Button Grid.Column="6"
                x:Name="ClearFilterButton"
                Content="清除"
                Click="ClearFilter_Click"
                Margin="8,0,0,0" />
      </Grid>
    </Border>

    <DataGrid Grid.Row="3"
              x:Name="DataGrid"
              Margin="12"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserResizeColumns="True"
              CanUserSortColumns="False"
              GridLinesVisibility="All"
              HeadersVisibility="All"
              SelectionMode="Single"
              SelectionChanged="DataGrid_SelectionChanged"
              DoubleTapped="DataGrid_DoubleTapped" />

    <Border Grid.Row="4" Background="#F2F4F7" BorderBrush="#CDD5E0" BorderThickness="0,1,0,0" Padding="12,8">
      <TextBlock x:Name="StatusText" Text="正在載入資料…" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
